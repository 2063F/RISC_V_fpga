# Gowin EDA synthesis/PnR build outputs (regenerate via build.tcl)
/impl/
gowin_project/*/impl/
*.gprj.user

# Icarus Verilog simulation build outputs
sim/*.out

# Waveform dumps
*.vcd

# ROM image staged next to the Gowin project by build.tcl
gowin_project/*/examples/

# Verilator build outputs
sim/verilator/obj/

# オセロAI FPGA 版のビルド中間生成物 (othello_fpga.hex だけをコミットする)
othello_ai_c/othello_AI/othello_fpga.elf
othello_ai_c/othello_AI/othello_fpga.bin
