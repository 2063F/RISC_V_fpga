// =============================================================================
// Tang Primer 25K Dock - Pin Constraint File
// FPGA: Gowin GW5A-LV25MG121NC1/I0
// Board: Sipeed Tang Primer 25K + Dock
// =============================================================================

// --- System Clock (50 MHz Crystal Oscillator) ---
IO_LOC "clk" E2;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// --- Reset Button (Active High, directly usable) ---
IO_LOC "rst_btn" H11;
IO_PORT "rst_btn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// --- User Button ---
IO_LOC "user_btn" H10;
IO_PORT "user_btn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// --- Onboard LEDs ---
IO_LOC "led[0]" E8;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC "led[1]" D7;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// --- UART (via onboard USB-JTAG debugger) ---
// Note: Confirm these pins from the official schematic for your board revision.
// IO_LOC "uart_tx" xxx;
// IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
// IO_LOC "uart_rx" xxx;
// IO_PORT "uart_rx" IO_TYPE=LVCMOS33;
