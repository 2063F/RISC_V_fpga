// =============================================================================
// Tang Primer 25K Dock - Pin Constraint File (回路図 v1.1 確認済み)
// =============================================================================

// --- System Clock (50MHz) ---
IO_LOC "clk" E2;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// --- Reset Button S1 (Active High, H11=IOT3A_S1) ---
IO_LOC "rst_btn" H11;
IO_PORT "rst_btn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// --- User Button S2 (H10=IOT3B_S2) ---
IO_LOC "user_btn" H10;
IO_PORT "user_btn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// --- UART (BL616デバッガ経由、USB-Cで接続) ---
IO_LOC "uart_tx" C3;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "uart_rx" B3;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- Onboard LEDs (READY=E8, DONE=D7 - dual-purpose option enabled in build) ---
IO_LOC "led[0]" E8;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[1]" D7;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// --- 8x8 キースイッチマトリクス (keypad_matrix.v) ---
// 行: FPGA が1本ずつ Low を出力し、それ以外はハイインピーダンス。
IO_LOC "kbd_row_n[0]" J11;
IO_LOC "kbd_row_n[1]" F7;
IO_LOC "kbd_row_n[2]" J8;
IO_LOC "kbd_row_n[3]" L9;
IO_LOC "kbd_row_n[4]" L10;
IO_LOC "kbd_row_n[5]" L7;
IO_LOC "kbd_row_n[6]" K7;
IO_LOC "kbd_row_n[7]" H1;
IO_PORT "kbd_row_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// 列: 内蔵プルアップ。押されたキーの行が Low のとき Low になる。
IO_LOC "kbd_col_n[0]" J10;
IO_LOC "kbd_col_n[1]" F6;
IO_LOC "kbd_col_n[2]" K8;
IO_LOC "kbd_col_n[3]" K9;
IO_LOC "kbd_col_n[4]" K10;
IO_LOC "kbd_col_n[5]" L8;
IO_LOC "kbd_col_n[6]" J7;
IO_LOC "kbd_col_n[7]" H2;
IO_PORT "kbd_col_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- 8x8 赤/緑 ドットマトリクス LED (LTP-12188M-08, led_matrix_bicolor.v) ---
// 行 (アノード): 680Ω → PNP のベースへ。Low で点灯する行を選ぶ。
//   led_row[k] -> LED 行(k+1): LED ピン 22,19,16,13,3,6,9,12 (k=0..7)
// 列 (カソード): 68Ω → LED のカソードへ。Low で点灯 (LED 1個分 約12mA を吸い込む)。
//   led_col_r[k] -> LED 列(k+1) 赤: LED ピン 23,20,17,14,2,5,8,11
//   led_col_g[k] -> LED 列(k+1) 緑: LED ピン 24,21,18,15,1,4,7,10
IO_LOC "led_row[0]" B11;
IO_LOC "led_row[1]" E11;
IO_LOC "led_row[2]" F5;
IO_LOC "led_row[3]" H5;
IO_LOC "led_row[4]" B10;
IO_LOC "led_row[5]" E10;
IO_LOC "led_row[6]" G5;
IO_LOC "led_row[7]" J5;
IO_PORT "led_row[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led_col_r[0]" D11;
IO_LOC "led_col_r[1]" A11;
IO_LOC "led_col_r[2]" L5;
IO_LOC "led_col_r[3]" H8;
IO_LOC "led_col_r[4]" D10;
IO_LOC "led_col_r[5]" A10;
IO_LOC "led_col_r[6]" K5;
IO_LOC "led_col_r[7]" H7;
IO_PORT "led_col_r[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_r[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_r[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_r[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_r[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_r[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_r[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_r[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_LOC "led_col_g[0]" G11;
IO_LOC "led_col_g[1]" C11;
IO_LOC "led_col_g[2]" K11;
IO_LOC "led_col_g[3]" G7;
IO_LOC "led_col_g[4]" G10;
IO_LOC "led_col_g[5]" C10;
IO_LOC "led_col_g[6]" L11;
IO_LOC "led_col_g[7]" G8;
IO_PORT "led_col_g[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_g[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_g[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_g[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_g[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_g[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_g[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
IO_PORT "led_col_g[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=16;
