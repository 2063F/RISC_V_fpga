// =============================================================================
// Tang Primer 25K Dock - Pin Constraint File (回路図 v1.1 確認済み)
// =============================================================================

// --- System Clock (50MHz) ---
IO_LOC "clk" E2;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// --- Reset Button S1 (Active High, H11=IOT3A_S1) ---
IO_LOC "rst_btn" H11;
IO_PORT "rst_btn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// --- User Button S2 (H10=IOT3B_S2) ---
IO_LOC "user_btn" H10;
IO_PORT "user_btn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// --- UART (BL616デバッガ経由、USB-Cで接続) ---
IO_LOC "uart_tx" C3;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "uart_rx" B3;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- Onboard LEDs (READY=E8, DONE=D7 - dual-purpose option enabled in build) ---
IO_LOC "led[0]" E8;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[1]" D7;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
// --- 8x8 キースイッチマトリクス (keypad_matrix.v) ---
// ピン番号は Sipeed 公式サンプル TangPrimer-25K-example/pmod_led/src/pmod_led.cst の
// pmod_io[0..15] と同じ。どの PMOD コネクタのどの端子かは、配線前に Dock の
// 回路図 / シルクで必ず確認すること（未確認）。3.3V 系。
// 行: FPGA が1本ずつ Low を出力し、それ以外はハイインピーダンス。
IO_LOC "kbd_row_n[0]" G5;
IO_LOC "kbd_row_n[1]" F5;
IO_LOC "kbd_row_n[2]" G7;
IO_LOC "kbd_row_n[3]" G8;
IO_LOC "kbd_row_n[4]" H7;
IO_LOC "kbd_row_n[5]" H8;
IO_LOC "kbd_row_n[6]" L5;
IO_LOC "kbd_row_n[7]" K5;
IO_PORT "kbd_row_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_row_n[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// 列: 内蔵プルアップ。押されたキーの行が Low のとき Low になる。
IO_LOC "kbd_col_n[0]" J5;
IO_LOC "kbd_col_n[1]" H5;
IO_LOC "kbd_col_n[2]" L9;
IO_LOC "kbd_col_n[3]" K9;
IO_LOC "kbd_col_n[4]" J8;
IO_LOC "kbd_col_n[5]" K8;
IO_LOC "kbd_col_n[6]" F6;
IO_LOC "kbd_col_n[7]" F7;
IO_PORT "kbd_col_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "kbd_col_n[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// --- 8x8 赤/緑 ドットマトリクス LED (LTP-12188M-08, led_matrix_bicolor.v) ---
// ピン番号は Sipeed 公式サンプル pmod_led.cst の pmod_io[16..39] と同じ。
// どのコネクタのどの端子かは、配線前に Dock の回路図 / シルクで必ず確認すること（未確認）。
// 行 (アノード): PNP トランジスタのベースへ。Low で点灯する行を選ぶ。
// 列 (カソード): 電流制限抵抗を通して LED のカソードへ。Low で点灯。
IO_LOC "led_row[0]" L2;
IO_LOC "led_row[1]" L1;
IO_LOC "led_row[2]" K1;
IO_LOC "led_row[3]" K2;
IO_LOC "led_row[4]" J4;
IO_LOC "led_row[5]" K4;
IO_LOC "led_row[6]" G2;
IO_LOC "led_row[7]" G1;
IO_PORT "led_row[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_row[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led_col_r[0]" F1;
IO_LOC "led_col_r[1]" B2;
IO_LOC "led_col_r[2]" A1;
IO_LOC "led_col_r[3]" C2;
IO_LOC "led_col_r[4]" E1;
IO_LOC "led_col_r[5]" F2;
IO_LOC "led_col_r[6]" D1;
IO_LOC "led_col_r[7]" E3;
IO_PORT "led_col_r[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_r[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_r[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_r[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_r[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_r[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_r[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_r[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led_col_g[0]" L4;
IO_LOC "led_col_g[1]" J1;
IO_LOC "led_col_g[2]" H1;
IO_LOC "led_col_g[3]" G4;
IO_LOC "led_col_g[4]" H2;
IO_LOC "led_col_g[5]" H4;
IO_LOC "led_col_g[6]" L3;
IO_LOC "led_col_g[7]" J2;
IO_PORT "led_col_g[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_g[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_g[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_g[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_g[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_g[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_g[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "led_col_g[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
