    %vpi_call 2 85 "$display", "BAUD_RATE=%0d, BIT_PERIOD=%0dns", P_0000022be241f5a0, P_0000022be241f610 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0000022be27f8e90_0, 0, 1;
    %pushi/vec4 4, 0, 32;
T_20.0 %dup/vec4;
    %pushi/vec4 0, 0, 32;
    %cmp/s;
    %jmp/1xz T_20.1, 5;
    %jmp/1 T_20.1, 4;
    %pushi/vec4 1, 0, 32;
    %sub;
    %wait E_0000022be24374d0;
    %jmp T_20.0;
T_20.1 ;
    %pop/vec4 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0000022be27f8e90_0, 0, 1;
    %vpi_call 2 91 "$display", "Reset released at time %0t", $time {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0000022be27f6660_0, 0, 32;
    %vpi_call 2 96 "$write", "Received: [" {0 0 0};
T_20.2 ;
    %load/vec4 v0000022be27f6660_0;
    %cmpi/s 34, 0, 32;
    %jmp/0xz T_20.3, 5;
    %fork TD_tb_uart_cpu.recv_byte, S_0000022be24012d0;
    %join;
    %load/vec4 v0000022be27f7240_0;
    %store/vec4 v0000022be27f87b0_0, 0, 8;
    %load/vec4 v0000022be27f87b0_0;
    %cmpi/e 13, 0, 8;
    %jmp/0xz  T_20.4, 4;
    %jmp T_20.5;
T_20.4 ;
    %load/vec4 v0000022be27f87b0_0;
    %cmpi/e 10, 0, 8;
    %jmp/0xz  T_20.6, 4;
    %vpi_call 2 102 "$write", "\134n" {0 0 0};
    %jmp T_20.7;
T_20.6 ;
    %vpi_call 2 104 "$write", "%s", v0000022be27f87b0_0 {0 0 0};
T_20.7 ;
T_20.5 ;
    %load/vec4 v0000022be27f6660_0;
    %addi 1, 0, 32;
    %store/vec4 v0000022be27f6660_0, 0, 32;
    %jmp T_20.2;
T_20.3 ;
    %vpi_call 2 108 "$display", "]" {0 0 0};
    %vpi_call 2 109 "$display", "=== %0d chars received, simulation complete ===", v0000022be27f6660_0 {0 0 0};
    %delay 1000000, 0;
    %vpi_call 2 112 "$finish" {0 0 0};
    %end;
    .thread T_20;
    .scope S_0000022be2452060;
T_21 ;
    %delay 552894464, 46566;
    %vpi_call 2 118 "$display", "TIMEOUT: simulation did not finish in time" {0 0 0};
    %vpi_call 2 119 "$finish" {0 0 0};
    %end;
    .thread T_21;
